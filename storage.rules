rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'help@wildsaura.com',
          'madan123050@gmail.com'
        ];
    }

    match /submissions/{userId}/{submissionId}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && fileName in ['original', 'preview.jpg']
        && (
          (fileName == 'original' && request.resource.size <= 50 * 1024 * 1024)
          || (fileName == 'preview.jpg' && request.resource.size <= 4 * 1024 * 1024)
        )
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId)
        || (
          fileName == 'preview.jpg'
          && firestore.get(/databases/(default)/documents/submissions/$(submissionId)).data.status == 'approved'
        );

      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow update: if false;
    }
  }
}
