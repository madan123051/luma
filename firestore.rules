rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'help@wildsaura.com',
          'madan123050@gmail.com'
        ];
    }

    match /submissions/{submissionId} {
      allow read: if resource.data.status == 'approved'
        || isAdmin()
        || (signedIn() && resource.data.submitterUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'slug', 'category', 'description', 'photographerName',
          'submitterEmail', 'submitterUid', 'storagePath', 'previewPath',
          'standardPath', 'downloadUrl', 'standardDownloadUrl',
          'contentType', 'fileSize', 'previewFileSize', 'standardFileSize',
          'mediaType', 'durationSeconds', 'posterPath', 'posterDownloadUrl',
          'publicVersion', 'status', 'adminNote', 'createdAt', 'reviewedAt',
          'reviewedBy', 'tags', 'keywords', 'altText', 'seoTitle',
          'seoDescription', 'aiGenerated'
        ])
        && request.resource.data.submitterUid == request.auth.uid
        && request.resource.data.submitterEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 110
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.photographerName is string
        && request.resource.data.photographerName.size() > 0
        && request.resource.data.photographerName.size() <= 100
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 16
        && request.resource.data.keywords is list
        && request.resource.data.keywords.size() <= 20
        && request.resource.data.altText is string
        && request.resource.data.altText.size() <= 240
        && request.resource.data.seoTitle is string
        && request.resource.data.seoTitle.size() <= 70
        && request.resource.data.seoDescription is string
        && request.resource.data.seoDescription.size() <= 170
        && request.resource.data.aiGenerated is bool
        && (
          request.resource.data.status == 'pending'
          || (isAdmin() && request.resource.data.status == 'approved')
        )
        && request.resource.data.storagePath == 'submissions/' + request.auth.uid + '/' + submissionId + '/original'
        && request.resource.data.mediaType is string
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.durationSeconds is number
        && (
          (request.resource.data.mediaType == 'image'
            && request.resource.data.contentType.matches('image/(jpeg|png|webp)')
            && request.resource.data.durationSeconds == 0
            && request.resource.data.fileSize <= 50 * 1024 * 1024
            && request.resource.data.previewFileSize <= 4 * 1024 * 1024
            && request.resource.data.previewPath == 'submissions/' + request.auth.uid + '/' + submissionId + '/preview.jpg'
            && !request.resource.data.keys().hasAny(['posterPath', 'posterDownloadUrl']))
          || (request.resource.data.mediaType == 'video'
            && request.resource.data.contentType.matches('video/.*')
            && request.resource.data.durationSeconds >= 10
            && request.resource.data.durationSeconds <= 30
            && request.resource.data.fileSize <= 300 * 1024 * 1024
            && request.resource.data.previewFileSize <= 50 * 1024 * 1024
            && request.resource.data.previewPath == 'submissions/' + request.auth.uid + '/' + submissionId + '/preview.webm'
            && request.resource.data.posterPath == 'submissions/' + request.auth.uid + '/' + submissionId + '/poster.jpg'
            && request.resource.data.posterDownloadUrl is string
            && request.resource.data.posterDownloadUrl.size() > 0
            && request.resource.data.posterDownloadUrl.size() <= 2048)
        )
        && (
          !request.resource.data.keys().hasAny([
            'standardPath', 'standardDownloadUrl', 'standardFileSize'
          ])
          || (
            isAdmin()
            && request.resource.data.keys().hasAll([
              'standardPath', 'standardDownloadUrl', 'standardFileSize'
            ])
            && request.resource.data.standardDownloadUrl is string
            && request.resource.data.standardDownloadUrl.size() > 0
            && request.resource.data.standardDownloadUrl.size() <= 2048
            && request.resource.data.standardFileSize > 0
            && request.resource.data.standardFileSize <= 25 * 1024 * 1024
            && (
              (request.resource.data.mediaType == 'image' && request.resource.data.standardPath == 'submissions/' + request.auth.uid + '/' + submissionId + '/standard.jpg')
              || (request.resource.data.mediaType == 'video' && request.resource.data.standardPath == 'submissions/' + request.auth.uid + '/' + submissionId + '/standard.webm')
            )
          )
        )
        && request.resource.data.publicVersion == true;

      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn()
          && resource.data.submitterUid == request.auth.uid
          && resource.data.status == 'pending');
    }

    match /photoStats/{photoId} {
      function likePath() {
        return /databases/$(database)/documents/photoStats/$(photoId)/likes/$(request.auth.uid);
      }

      function sharePath() {
        return /databases/$(database)/documents/photoStats/$(photoId)/shares/$(request.auth.uid);
      }

      function validStats() {
        return request.resource.data.keys().hasOnly(['likesCount', 'sharesCount', 'updatedAt'])
          && request.resource.data.likesCount is int
          && request.resource.data.sharesCount is int
          && request.resource.data.likesCount >= 0
          && request.resource.data.sharesCount >= 0
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if true;
      allow create: if signedIn()
        && validStats()
        && request.resource.data.likesCount <= 1
        && request.resource.data.sharesCount <= 1
        && (request.resource.data.likesCount == 0 || existsAfter(likePath()))
        && (request.resource.data.sharesCount == 0 || existsAfter(sharePath()));
      allow update: if signedIn()
        && validStats()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount', 'sharesCount', 'updatedAt'])
        && request.resource.data.likesCount - resource.data.likesCount >= -1
        && request.resource.data.likesCount - resource.data.likesCount <= 1
        && request.resource.data.sharesCount - resource.data.sharesCount >= 0
        && request.resource.data.sharesCount - resource.data.sharesCount <= 1
        && (
          request.resource.data.likesCount == resource.data.likesCount
          || (
            request.resource.data.likesCount == resource.data.likesCount + 1
            && !exists(likePath())
            && existsAfter(likePath())
          )
          || (
            request.resource.data.likesCount == resource.data.likesCount - 1
            && exists(likePath())
            && !existsAfter(likePath())
          )
        )
        && (
          request.resource.data.sharesCount == resource.data.sharesCount
          || (
            request.resource.data.sharesCount == resource.data.sharesCount + 1
            && !exists(sharePath())
            && existsAfter(sharePath())
          )
        );
      allow delete: if false;

      match /likes/{userId} {
        allow read: if true;
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && userId == request.auth.uid;
        allow update: if false;
      }

      match /shares/{userId} {
        allow read: if true;
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
      }
    }
  }
}
